    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "from datetime import datetime\n",
    "from pandas.tseries.offsets import MonthBegin\n",
    "\n",
    "# ==========================================================\n",
    "# Preprocessing\n",
    "# ==========================================================\n",
    "df['Arrival'] = pd.to_datetime(df['Arrival'])\n",
    "\n",
    "# Data Include Cancelled\n",
    "df_include = df.copy()\n",
    "\n",
    "# Data Exclude Cancelled\n",
    "df_exclude = df[df['Status'].str.upper() != 'CANCELLED'].copy()\n",
    "\n",
    "# ==========================================================\n",
    "# Function\n",
    "# ==========================================================\n",
    "def plot_monthly_nights(data, title):\n",
    "    \n",
    "    # Total Nights per bulan\n",
    "    monthly_nights = (\n",
    "        data.groupby(data['Arrival'].dt.to_period('M'))['Nights']\n",
    "        .sum()\n",
    "    )\n",
    "\n",
    "    monthly_nights.index = monthly_nights.index.to_timestamp()\n",
    "\n",
    "    # Waktu sekarang\n",
    "    this_month = pd.Timestamp(datetime.now()).replace(\n",
    "        day=1,\n",
    "        hour=0,\n",
    "        minute=0,\n",
    "        second=0,\n",
    "        microsecond=0\n",
    "    )\n",
    "\n",
    "    last_month = this_month - MonthBegin(1)\n",
    "\n",
    "    # Segment warna\n",
    "    past_blue = monthly_nights[monthly_nights.index <= last_month]\n",
    "\n",
    "    transition_yellow = monthly_nights[\n",
    "        (monthly_nights.index >= last_month) &\n",
    "        (monthly_nights.index <= this_month)\n",
    "    ]\n",
    "\n",
    "    future_green = monthly_nights[\n",
    "        monthly_nights.index >= this_month\n",
    "    ]\n",
    "\n",
    "    # Plot\n",
    "    plt.figure(figsize=(13,6))\n",
    "\n",
    "    plt.plot(\n",
    "        past_blue.index,\n",
    "        past_blue.values,\n",
    "        marker='o',\n",
    "        color='royalblue',\n",
    "        linewidth=2,\n",
    "        label='Past'\n",
    "    )\n",
    "\n",
    "    plt.plot(\n",
    "        transition_yellow.index,\n",
    "        transition_yellow.values,\n",
    "        marker='o',\n",
    "        color='gold',\n",
    "        linewidth=3,\n",
    "        label='Current'\n",
    "    )\n",
    "\n",
    "    plt.plot(\n",
    "        future_green.index,\n",
    "        future_green.values,\n",
    "        marker='o',\n",
    "        linestyle='--',\n",
    "        color='forestgreen',\n",
    "        linewidth=2,\n",
    "        label='Future'\n",
    "    )\n",
    "\n",
    "    # Label angka\n",
    "    offset = monthly_nights.max() * 0.02\n",
    "\n",
    "    for x, y in monthly_nights.items():\n",
    "        plt.text(\n",
    "            x,\n",
    "            y + offset,\n",
    "            f'{int(y)}',\n",
    "            ha='center',\n",
    "            fontsize=9,\n",
    "            fontweight='bold'\n",
    "        )\n",
    "\n",
    "    plt.title(title, fontsize=15, fontweight='bold')\n",
    "    plt.xlabel(\"Arrival Month\")\n",
    "    plt.ylabel(\"Total Nights\")\n",
    "\n",
    "    plt.axvline(\n",
    "        this_month,\n",
    "        color='red',\n",
    "        linestyle=':',\n",
    "        alpha=0.6,\n",
    "        label='Current Month'\n",
    "    )\n",
    "\n",
    "    plt.grid(True, linestyle='--', alpha=0.5)\n",
    "    plt.legend()\n",
    "\n",
    "    plt.xticks(\n",
    "        monthly_nights.index,\n",
    "        monthly_nights.index.strftime('%b %Y'),\n",
    "        rotation=45\n",
    "    )\n",
    "\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "# ==========================================================\n",
    "# Plot Include Cancelled\n",
    "# ==========================================================\n",
    "plot_monthly_nights(\n",
    "    df_include,\n",
    "    \"Total Nights per Month (Include CANCELLED)\"\n",
    ")\n",
    "\n",
    "# ==========================================================\n",
    "# Plot Exclude Cancelled\n",
    "# ==========================================================\n",
    "plot_monthly_nights(\n",
    "    df_exclude,\n",
    "    \"Total Nights per Month (Exclude CANCELLED)\"\n",
    ")"
   ]
